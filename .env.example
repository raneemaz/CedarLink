# Copy this file to .env and adjust. Both Flask's CLI and the app load it
# automatically (python-dotenv). Never commit the real .env.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------

# Points the `flask` CLI at the app. Required for `flask db upgrade`,
# `flask create-admin`, `flask seed`, `flask run`.
FLASK_APP=run.py

# Which config class to load: development | testing | production
# development  - SQLite file, permissive, placeholder secrets allowed
# production   - fails to start unless the three secrets below are set;
#                also disables `flask seed`
FLASK_CONFIG=development

# ---------------------------------------------------------------------------
# Secrets  (required when FLASK_CONFIG=production; optional in development,
#           where a throwaway default is substituted)
# ---------------------------------------------------------------------------

SECRET_KEY=dev-only-change-me
JWT_SECRET_KEY=dev-only-change-me

# Fernet key that encrypts stored TOTP secrets. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TWO_FACTOR_ENCRYPTION_KEY=ZmDfcTF7_60GrrY167zsiPd67pEvs0aGOv2oasOM1Pg=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# SQLAlchemy URL. If unset, defaults to sqlite:///cedarlink.db, which lives
# in instance/. A relative sqlite:/// path is resolved against instance/.
# DATABASE_URL=sqlite:///cedarlink.db

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------

# Comma-separated list of browser origins allowed to call /api/*.
# If unset it defaults to the local Vite dev ports (5173-5175).
# In production set it to the exact origin(s) the frontend is served from,
# e.g. CORS_ORIGINS=https://cedarlink.example
# CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# Email  (verification codes for register / login / password reset)
# ---------------------------------------------------------------------------

# Keep true in development: codes are printed to the server console instead
# of being sent. Set to false in production and configure a real SMTP server.
MAIL_SUPPRESS_SEND=true

# MAIL_SERVER=smtp.example.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USE_SSL=false
# MAIL_USERNAME=apikey
# MAIL_PASSWORD=
# MAIL_FROM=CedarLink <no-reply@cedarlink.example>

# ---------------------------------------------------------------------------
# Payments
# ---------------------------------------------------------------------------

# Shared secret used to verify incoming payment-provider webhooks.
# PAYMENT_WEBHOOK_SECRET=change-me
