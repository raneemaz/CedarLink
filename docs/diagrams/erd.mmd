---
title: CedarLink — entity relationship diagram
---
%% All 26 tables and all 36 foreign keys, read from the SQLAlchemy metadata
%% on 2026-09-04. Cardinality follows the FK's nullability:
%%   ||--o{  parent to many children, child's FK is NOT NULL
%%   |o--o{  parent to many children, child's FK is nullable
%% --
%% Only columns that carry a decision are listed — keys, money, status and
%% the fields an ADR turns on. Timestamps and free text are omitted.

erDiagram

    users ||--o{ stores : owns
    users ||--o{ orders : places
    users ||--o{ addresses : saves
    users ||--o| carts : has
    users ||--o{ reviews : writes
    users ||--o{ review_reports : reports
    users ||--o{ payment_methods : registers
    users ||--o{ notifications : receives
    users ||--o| notification_preferences : configures
    users ||--o| shopping_preferences : configures
    users ||--o{ two_factor_challenges : issued
    users ||--o{ two_factor_recovery_codes : holds
    users ||--o{ token_denylist : revokes
    users ||--o{ coupon_redemptions : redeems

    stores ||--o{ products : lists
    stores ||--o{ orders : fulfils
    stores ||--o{ store_hours : opens
    stores ||--o{ store_announcements : posts
    stores |o--o{ reviews : "is reviewed"
    stores |o--o{ coupons : "scopes (NULL = platform-wide)"

    categories ||--o{ products : classifies
    categories ||--o{ shopping_interests : "is an interest"

    products ||--o{ product_images : shows
    products ||--o{ order_items : "sold as"
    products ||--o{ cart_items : "held as"
    products |o--o{ reviews : "is reviewed"

    carts ||--o{ cart_items : contains

    orders ||--o{ order_items : contains
    orders ||--o{ payments : "paid by"
    orders ||--o| delivery_assignments : "delivered by"
    orders ||--o{ reviews : "verifies purchase for"
    orders ||--o| coupon_redemptions : "discounted by"

    coupons ||--o{ coupon_redemptions : "spent as"

    reviews ||--o{ review_reports : "is reported by"

    payment_methods |o--o{ payments : "charged to"

    shopping_preferences ||--o{ shopping_interests : ranks

    users {
        int id PK
        string email UK
        string role "customer|vendor|admin"
        string password "hash only"
        bool is_verified
        bool is_active
        datetime suspended_at "nullable"
        datetime deleted_at "soft delete"
        bool two_factor_enabled
        string two_factor_method "email|totp"
        text two_factor_totp_secret "Fernet-encrypted"
        int two_factor_last_totp_counter "one-time use, ADR 0020"
        datetime tokens_revoked_at "bulk revocation"
    }

    stores {
        int id PK
        int owner_id FK
        string name
        string location
        string approval_status "pending|approved|rejected"
        bool is_active
        bool is_online_only "no shopfront, ADR 0018"
        decimal latitude "Numeric(9,6)"
        decimal longitude "Numeric(9,6)"
        decimal inside_city_delivery_fee
        decimal outside_city_delivery_fee
        string override_status "open|closed"
        string override_reason
        datetime override_until "naive UTC, ADR 0013"
        decimal rating_avg "aggregate, ADR 0015"
        int rating_count
        text approval_note "admin-only, ADR 0019"
        datetime deleted_at "soft delete"
    }

    products {
        int id PK
        int store_id FK
        int category_id FK
        string name_en "required"
        string name_ar "nullable, falls back"
        string name_fr "nullable, falls back"
        decimal price "Numeric(10,2)"
        int stock "conditional UPDATE, CL-06"
        decimal rating_avg
        int rating_count
        datetime deleted_at "soft delete"
    }

    categories {
        int id PK
        string name_en UK
        string name_ar
        string name_fr
    }

    orders {
        int id PK
        int user_id FK
        int store_id FK
        string status "pending|processing|delivered|canceled"
        decimal total_price "goods - discount + delivery"
        decimal delivery_fee "stored, not derived"
        string delivery_address
        string delivery_city
    }

    order_items {
        int id PK
        int order_id FK
        int product_id FK
        int quantity
        decimal unit_price "price at purchase"
    }

    carts {
        int id PK
        int user_id FK,UK
        string coupon_code "held, ADR 0021"
    }

    cart_items {
        int id PK
        int cart_id FK
        int product_id FK
        int quantity
    }

    coupons {
        int id PK
        string code UK "stored uppercase"
        string discount_type "percentage|fixed"
        decimal value "CHECK by type"
        decimal min_order_total "pre-discount goods"
        datetime starts_at
        datetime ends_at
        int usage_limit "NULL = unlimited"
        int per_user_limit "NULL = unlimited"
        int used_count "conditional UPDATE"
        int store_id FK "NULL = platform-wide"
        bool is_active
    }

    coupon_redemptions {
        int id PK
        int coupon_id FK
        int user_id FK
        int order_id FK
        decimal amount_applied "recorded, not recomputed"
    }

    reviews {
        int id PK
        int user_id FK
        int order_id FK "verified purchase"
        int product_id FK "nullable"
        int store_id FK "nullable, CHECK exactly one"
        smallint rating "CHECK 1-5"
        string status "published|flagged|removed"
        text moderation_note "admin-only, ADR 0017"
    }

    review_reports {
        int id PK
        int review_id FK
        int user_id FK
        string reason
    }

    store_hours {
        int id PK
        int store_id FK
        int day_of_week "0 = Monday"
        time opens_at "local wall clock"
        time closes_at "<= opens_at crosses midnight"
    }

    store_announcements {
        int id PK
        int store_id FK
        string title
        datetime starts_at
        datetime ends_at "nullable"
        bool is_active "max 5 active"
    }

    addresses {
        int id PK
        int user_id FK
        string label "Home|Work|Other"
        string address_line
        string city
        bool is_default
        decimal latitude "nullable pin"
        decimal longitude "nullable pin"
    }

    shopping_preferences {
        int id PK
        int user_id FK,UK
        bool autofill_default_address
        string preferred_payment_method
        string default_delivery_city
        bool hide_out_of_stock
    }

    shopping_interests {
        int id PK
        int preferences_id FK
        int category_id FK
        int position "customer's own order"
    }

    payments {
        int id PK
        int order_id FK
        int payment_method_id FK "nullable"
        decimal amount
        string status
    }

    payment_methods {
        int id PK
        int user_id FK
        string provider_token "never a card number"
        string last_four
    }

    delivery_assignments {
        int id PK
        int order_id FK
        string driver_name
        string driver_phone "scoped disclosure, ADR 0019"
        string status "assigned|picked_up|delivered"
    }

    notifications {
        int id PK
        int user_id FK
        string category "order_updates|promotions"
        string type
        bool is_read
    }

    notification_preferences {
        int id PK
        int user_id FK,UK
        bool order_updates
        bool promotions
        bool email
        bool in_app
    }

    two_factor_challenges {
        int id PK
        int user_id FK
        string token_hash UK "SHA-256, never plaintext"
        string purpose "login|setup|security|registration|password_reset"
        string method
        string code_hash
        text totp_secret_encrypted
        int attempt_count "cap 5"
        datetime consumed_at
        datetime expires_at
    }

    two_factor_recovery_codes {
        int id PK
        int user_id FK
        string code_hash "hashed, single use"
        bool used
    }

    token_denylist {
        int id PK
        int user_id FK
        string jti UK
        datetime expires_at
    }

    product_images {
        int id PK
        int product_id FK
        string image_url
    }
